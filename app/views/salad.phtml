<!-- ========================================
PAGE DES SALADES
======================================== -->

<!-- Hero Section -->
<section id="salad-hero" class="animate-on-scroll">
  <article class="hero-content">
    <header>
      <h1>Nos Salades Fraîches</h1>
      <p>Découvrez notre sélection de salades préparées avec des ingrédients locaux et de saison</p>
    </header>
  </article>
</section>

<!-- Filtres et recherche -->
<section id="salad-filters" class="animate-on-scroll">
  <article class="filters-container">
    <form class="search-box">
      <input type="text" placeholder="Rechercher une salade..." class="search-input">
      <i class="fas fa-search search-icon"></i>
    </form>
    <nav class="filter-buttons">
      <button class="filter-btn active" data-filter="all">Toutes</button>
      <button class="filter-btn" data-filter="vegetarian">Végétariennes</button>
      <button class="filter-btn" data-filter="protein">Avec protéines</button>
      <button class="filter-btn" data-filter="seasonal">De saison</button>
    </nav>
  </article>
</section>

<!-- Grille des salades -->
<section id="salad-grid" class="animate-on-scroll">
  <article class="salad-container">
    
    <!-- Salade 1 -->
    <article class="salad-card" data-category="vegetarian seasonal">
      <figure class="card-image">
        <img src="/app/public/images/salade1.webp" alt="Salade César Végétarienne" />
        <figcaption>
          <span class="card-badge vegetarian">Végétarien</span>
          <span class="card-badge seasonal">De saison</span>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3>Salade César Végétarienne</h3>
        </header>
        <p class="description">Laitue romaine, parmesan, croûtons maison, vinaigrette césar crémeuse</p>
        <section class="card-details">
          <nav class="ingredients">
            <span class="ingredient-tag">Laitue</span>
            <span class="ingredient-tag">Parmesan</span>
            <span class="ingredient-tag">Croûtons</span>
          </nav>
          <section class="nutrition">
            <span class="calories">320 kcal</span>
            <span class="protein">12g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€8.50</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="1">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>
    </article>

    <!-- Salade 2 -->
    <article class="salad-card" data-category="protein">
      <figure class="card-image">
        <img src="/app/public/images/salade2.webp" alt="Salade Quinoa Poulet" />
        <figcaption>
          <span class="card-badge protein">Protéines</span>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3>Salade Quinoa & Poulet</h3>
        </header>
        <p class="description">Quinoa bio, poulet grillé, avocat, tomates cerises, vinaigrette citron</p>
        <section class="card-details">
          <nav class="ingredients">
            <span class="ingredient-tag">Quinoa</span>
            <span class="ingredient-tag">Poulet</span>
            <span class="ingredient-tag">Avocat</span>
          </nav>
          <section class="nutrition">
            <span class="calories">450 kcal</span>
            <span class="protein">28g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€12.90</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="2">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>
    </article>

    <!-- Salade 3 -->
    <article class="salad-card" data-category="vegetarian seasonal">
      <figure class="card-image">
        <img src="/app/public/images/salade3.webp" alt="Salade Méditerranéenne" />
        <figcaption>
          <span class="card-badge vegetarian">Végétarien</span>
          <span class="card-badge seasonal">De saison</span>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3>Salade Méditerranéenne</h3>
        </header>
        <p class="description">Tomates, concombre, olives, feta, oignon rouge, huile d'olive extra vierge</p>
        <section class="card-details">
          <nav class="ingredients">
            <span class="ingredient-tag">Tomates</span>
            <span class="ingredient-tag">Feta</span>
            <span class="ingredient-tag">Olives</span>
          </nav>
          <section class="nutrition">
            <span class="calories">280 kcal</span>
            <span class="protein">8g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€9.20</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="3">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>
    </article>

    <!-- Salade 4 -->
    <article class="salad-card" data-category="protein seasonal">
      <figure class="card-image">
        <img src="/app/public/images/salade4.webp" alt="Salade Saumon Avocat" />
        <figcaption>
          <span class="card-badge protein">Protéines</span>
          <span class="card-badge seasonal">De saison</span>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3>Salade Saumon & Avocat</h3>
        </header>
        <p class="description">Saumon fumé, avocat, mesclun, radis, vinaigrette moutarde douce</p>
        <section class="card-details">
          <nav class="ingredients">
            <span class="ingredient-tag">Saumon</span>
            <span class="ingredient-tag">Avocat</span>
            <span class="ingredient-tag">Mesclun</span>
          </nav>
          <section class="nutrition">
            <span class="calories">380 kcal</span>
            <span class="protein">22g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€14.50</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="4">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
