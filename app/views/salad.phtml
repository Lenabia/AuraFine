            <span class="calories">420 kcal</span>
            <span class="protein">15g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€11.80</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="5">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>
    </article>

  </article>
</section>

<!-- Section informations -->
<section id="salad-info" class="animate-on-scroll">
  <article class="info-container">
    <article class="info-card">
      <header>
        <i class="fas fa-leaf"></i>
        <h3>Ingrédients Frais</h3>
      </header>
      <p>Tous nos ingrédients sont sélectionnés localement et préparés le jour même</p>
    </article>
    <article class="info-card">
      <header>
        <i class="fas fa-clock"></i>
        <h3>Préparation Rapide</h3>
      </header>
      <p>Vos salades sont préparées en moins de 10 minutes après votre commande</p>
    </article>
    <article class="info-card">
      <header>
        <i class="fas fa-heart"></i>
        <h3>Options Personnalisées</h3>
      </header>
      <p>Personnalisez vos salades selon vos préférences et restrictions alimentaires</p>
    </article>
  </article>
</section>
