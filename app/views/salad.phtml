  </div>
</section>

<!-- Section informations -->
<section id="salad-info" class="animate-on-scroll">
  <div class="info-container">
    <div class="info-card">
      <i class="fas fa-leaf"></i>
      <h3>Ingrédients Frais</h3>
      <p>Tous nos ingrédients sont sélectionnés localement et préparés le jour même</p>
    </div>
    <div class="info-card">
      <i class="fas fa-clock"></i>
      <h3>Préparation Rapide</h3>
      <p>Vos salades sont préparées en moins de 10 minutes après votre commande</p>
    </div>
    <div class="info-card">
      <i class="fas fa-heart"></i>
      <h3>Options Personnalisées</h3>
      <p>Personnalisez vos salades selon vos préférences et restrictions alimentaires</p>
    </div>
  </div>
</section>
