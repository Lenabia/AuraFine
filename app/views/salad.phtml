<!-- Hero Section -->
<section id="salad-hero" class="animate-on-scroll">
  <article class="hero-content">
    <header>
      <h1>Nos Salades Fraîches</h1>
      <p>Découvrez notre sélection de salades préparées avec des ingrédients locaux et de saison</p>
    </header>
  </article>
</section>

<!-- Filtres et recherche -->
<section id="salad-filters" class="animate-on-scroll">
  <article class="filters-container">
    <form class="search-box" action="<?php echo $_SERVER['PHP_SELF']; ?>" method="GET">
      <input 
        type="text" 
        placeholder="Rechercher une salade..." 
        class="search-input"
        name="search"
        value="<?php echo isset($_GET['search']) ? htmlspecialchars($_GET['search']) : ''; ?>"
      >
      <i class="fas fa-search search-icon"></i>
    </form>
    <nav class="filter-buttons">
      <?php if (isset($categories) && is_array($categories)): ?>
        <?php foreach ($categories as $category): ?>
          <button class="filter-btn <?php echo $category['id'] === 'all' ? 'active' : ''; ?>" data-filter="<?php echo htmlspecialchars($category['id']); ?>">
            <?php echo htmlspecialchars($category['nom']); ?>
          </button>
        <?php endforeach; ?>
      <?php endif; ?>
    </nav>
  </article>
</section>

<!-- Grille des salades -->
<section id="salad-grid" class="animate-on-scroll">
  <div class="salad-container">
    <?php if (isset($salades) && is_array($salades)): ?>
    <?php foreach ($salades as $salad): ?>
    
    <div  id class="salad-card" data-category="<?php echo isset($salad['categorie']) ? htmlspecialchars($salad['categorie']) : ''; ?>">
      <figure class="card-image">
        <img 
          src="<?php echo isset($salad['image']) ? htmlspecialchars($salad['image']) : '/app/public/images/salade1.webp'; ?>"
          alt="<?php echo isset($salad['nom']) ? htmlspecialchars($salad['nom']) : 'Salade'; ?>"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <?php if (isset($salad['badges']) && is_array($salad['badges'])): ?>
            <?php foreach ($salad['badges'] as $badge): ?>
              <span class="card-badge <?php echo htmlspecialchars($badge['type']); ?>"><?php echo htmlspecialchars($badge['nom']); ?></span>
            <?php endforeach; ?>
          <?php endif; ?>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3><?php echo isset($salad['nom']) ? htmlspecialchars($salad['nom']) : 'Salade César Végétarienne'; ?></h3>
        </header>
        <p class="description"><?php echo isset($salad['description']) ? htmlspecialchars($salad['description']) : 'Laitue romaine, parmesan, croûtons maison, vinaigrette césar crémeuse'; ?></p>
        <section class="card-details">
          <nav class="ingredients">
            <?php if (isset($salad['ingredients']) && is_array($salad['ingredients'])): ?>
              <?php foreach ($salad['ingredients'] as $ingredient): ?>
                <span class="ingredient-tag"><?php echo htmlspecialchars($ingredient); ?></span>
              <?php endforeach; ?>
            <?php endif; ?>
          </nav>
          <section class="nutrition">
            <span class="calories"><?php echo isset($salad['calories']) ? $salad['calories'] : '320'; ?> kcal</span>
            <span class="protein"><?php echo isset($salad['proteines']) ? $salad['proteines'] : '12'; ?>g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€<?php echo isset($salad['prix']) ? number_format($salad['prix'], 2) : '8.50'; ?></span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-salad-id="<?php echo isset($salad['id']) ? $salad['id'] : '1'; ?>">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>

    </div>
    <?php endforeach; ?>
    <?php endif; ?>

  </div>
</section>

