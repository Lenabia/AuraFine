    </article>

    <!-- Salade 5 -->
    <article class="salad-card" data-category="vegetarian">
      <figure class="card-image">
        <img src="/app/public/images/salade5.webp" alt="Salade Buddha Bowl" />
        <figcaption>
          <span class="card-badge vegetarian">Végétarien</span>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3>Buddha Bowl Végétarien</h3>
        </header>
        <p class="description">Riz complet, légumes rôtis, pois chiches, tahini, graines de sésame</p>
        <section class="card-details">
          <nav class="ingredients">
            <span class="ingredient-tag">Riz complet</span>
