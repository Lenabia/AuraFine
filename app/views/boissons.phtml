<!-- Filtres et recherche -->
<section id="produit-filters" class="animate-on-scroll">
  <article class="filters-container">
    <form class="search-box" action="<?php echo $_SERVER['PHP_SELF']; ?>" method="GET">
      <input 
        type="text" 
        placeholder="Rechercher une boisson..." 
        class="search-input"
        name="search"
        value="<?php echo isset($_GET['search']) ? htmlspecialchars($_GET['search']) : ''; ?>"
      >
      <i class="fas fa-search search-icon"></i>
    </form>
    <nav class="filter-buttons">
      <?php if (isset($categories) && is_array($categories)): ?>
        <?php foreach ($categories as $category): ?>
          <button class="filter-btn <?php echo $category['id'] === 'all' ? 'active' : ''; ?>" data-filter="<?php echo htmlspecialchars($category['id']); ?>">
            <?php echo htmlspecialchars($category['nom']); ?>
          </button>
        <?php endforeach; ?>
      <?php endif; ?>
    </nav>
  </article>
</section>

<!-- Grille des boissons -->
<section id="produit-grid" class="animate-on-scroll">
  <div class="produit-container">
    <?php if (isset($boissons) && is_array($boissons)): ?>
    <?php foreach ($boissons as $boisson): ?>
    
    <div class="produit-card" data-category="<?php echo isset($boisson['categorie']) ? htmlspecialchars($boisson['categorie']) : ''; ?>">
      <figure class="card-image">
        <img 
          src="<?php echo isset($boisson['image']) ? htmlspecialchars($boisson['image']) : '/app/public/images/wireframes/smoothiefraise.webp'; ?>"
          alt="<?php echo isset($boisson['nom']) ? htmlspecialchars($boisson['nom']) : 'Boisson'; ?>"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <?php if (isset($boisson['badges']) && is_array($boisson['badges'])): ?>
            <?php foreach ($boisson['badges'] as $badge): ?>
              <span class="card-badge <?php echo htmlspecialchars($badge['type']); ?>"><?php echo htmlspecialchars($badge['nom']); ?></span>
            <?php endforeach; ?>
          <?php endif; ?>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3><?php echo isset($boisson['nom']) ? htmlspecialchars($boisson['nom']) : 'Smoothie Fraise'; ?></h3>
        </header>
        <p class="description"><?php echo isset($boisson['description']) ? htmlspecialchars($boisson['description']) : 'Smoothie fraise et banane, frais et naturel'; ?></p>
        <section class="card-details">
          <nav class="ingredients">
            <?php if (isset($boisson['ingredients']) && is_array($boisson['ingredients'])): ?>
              <?php foreach ($boisson['ingredients'] as $ingredient): ?>
                <span class="ingredient-tag"><?php echo htmlspecialchars($ingredient); ?></span>
              <?php endforeach; ?>
            <?php endif; ?>
          </nav>
          <section class="nutrition">
            <span class="calories"><?php echo isset($boisson['calories']) ? $boisson['calories'] : '180'; ?> kcal</span>
            <span class="protein"><?php echo isset($boisson['proteines']) ? $boisson['proteines'] : '3'; ?>g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price">€<?php echo isset($boisson['prix']) ? number_format($boisson['prix'], 2) : '4.50'; ?></span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-boisson-id="<?php echo isset($boisson['id']) ? $boisson['id'] : '1'; ?>">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>

    </div>
    <?php endforeach; ?>
    <?php endif; ?>

  </div>
</section>

