      <input 
        type="text" 
        placeholder="Rechercher un fruit ou légume..." 
        class="search-input"
        name="search"
        value="<?php echo isset($_GET['search']) ? htmlspecialchars($_GET['search']) : ''; ?>"
      >
      <i class="fas fa-search search-icon"></i>
    </form>
    <nav class="filter-buttons">
      <?php if (isset($categories) && is_array($categories)): ?>
        <?php foreach ($categories as $category): ?>
          <button class="filter-btn <?php echo $category['id'] === 'all' ? 'active' : ''; ?>" data-filter="<?php echo htmlspecialchars($category['id']); ?>">
            <?php echo htmlspecialchars($category['nom']); ?>
          </button>
        <?php endforeach; ?>
      <?php endif; ?>
    </nav>
  </article>
</section>

<!-- Grille des fruits et légumes -->
<section id="produit-grid" class="animate-on-scroll">
  <div class="produit-container">
    <?php if (isset($fruitsLegumes) && is_array($fruitsLegumes)): ?>
    <?php foreach ($fruitsLegumes as $item): ?>
    
    <div class="produit-card" data-category="<?php echo isset($item['categorie']) ? htmlspecialchars($item['categorie']) : ''; ?>">
      <figure class="card-image">
        <img 
          src="<?php echo isset($item['image']) ? htmlspecialchars($item['image']) : '/app/public/images/wireframes/salad.webp'; ?>"
