          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <?php if (isset($item['badges']) && is_array($item['badges'])): ?>
            <?php foreach ($item['badges'] as $badge): ?>
              <span class="card-badge <?php echo htmlspecialchars($badge['type']); ?>"><?php echo htmlspecialchars($badge['nom']); ?></span>
            <?php endforeach; ?>
          <?php endif; ?>
        </figcaption>
      </figure>
      <article class="card-content">
        <header>
          <h3><?php echo isset($item['nom']) ? htmlspecialchars($item['nom']) : 'Tomates Cerises'; ?></h3>
        </header>
        <p class="description"><?php echo isset($item['description']) ? htmlspecialchars($item['description']) : 'Tomates cerises fraîches et juteuses'; ?></p>
        <section class="card-details">
          <nav class="ingredients">
            <?php if (isset($item['ingredients']) && is_array($item['ingredients'])): ?>
              <?php foreach ($item['ingredients'] as $ingredient): ?>
                <span class="ingredient-tag"><?php echo htmlspecialchars($ingredient); ?></span>
              <?php endforeach; ?>
            <?php endif; ?>
          </nav>
          <section class="nutrition">
            <span class="calories"><?php echo isset($item['calories']) ? $item['calories'] : '25'; ?> kcal</span>
            <span class="protein"><?php echo isset($item['proteines']) ? $item['proteines'] : '1'; ?>g protéines</span>
          </section>
        </section>
        <footer class="card-footer">
          <section class="price-quantity">
            <span class="price"><?php echo isset($item['prix']) ? number_format($item['prix'], 0, ',', ' ') : '1,500'; ?> FCFA</span>
            <nav class="quantity-controls">
              <button class="qty-btn minus" data-action="decrease">-</button>
              <span class="quantity">1</span>
              <button class="qty-btn plus" data-action="increase">+</button>
            </nav>
          </section>
          <button class="add-to-cart-btn" data-item-id="<?php echo isset($item['id']) ? $item['id'] : '1'; ?>">
            <i class="fas fa-shopping-cart"></i>
            Ajouter
          </button>
        </footer>
      </article>

    </div>
    <?php endforeach; ?>
    <?php endif; ?>

  </div>
</section>

